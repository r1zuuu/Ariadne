POSTGRES_USER=ariadne
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ariadne
DATABASE_URL=postgresql://ariadne:change-me@localhost:5432/ariadne
# The role the server connects as. Owns nothing, so row-level security applies to
# it (migration 0008); the owner above is for migrations and admin scripts. The
# migration creates this role without a password, setup.md gives it one.
DATABASE_URL_APP=postgresql://ariadne_app:change-me-too@localhost:5432/ariadne
GEMINI_API_KEY=change-me
